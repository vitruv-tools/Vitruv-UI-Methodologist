<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="bom"
    nsURI="http://example.org/bom"
    nsPrefix="bom">

  <eClassifiers xsi:type="ecore:EClass" name="BOM">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="itemTypes"
        upperBound="-1"
        containment="true"
        eType="#//ItemType"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="items"
        upperBound="-1"
        containment="true"
        eType="#//Item"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ItemType">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parameterDefinitions"
        upperBound="-1"
        containment="true"
        eType="#//ParameterDefinition"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Item">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="id"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="quantity"
        defaultValueLiteral="1.0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="itemType"
        lowerBound="1"
        eType="#//ItemType"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="parameterValues"
        upperBound="-1"
        containment="true"
        eType="#//ParameterValue"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass"
      name="ParameterDefinition"
      abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="name"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass"
      name="StringParameterDefinition"
      eSuperTypes="#//ParameterDefinition"/>

  <eClassifiers xsi:type="ecore:EClass"
      name="NumberParameterDefinition"
      eSuperTypes="#//ParameterDefinition"/>

  <eClassifiers xsi:type="ecore:EClass"
      name="BoolParameterDefinition"
      eSuperTypes="#//ParameterDefinition"/>

  <eClassifiers xsi:type="ecore:EClass"
      name="ParameterValue"
      abstract="true">
    <eStructuralFeatures xsi:type="ecore:EReference"
        name="definition"
        lowerBound="1"
        eType="#//ParameterDefinition"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass"
      name="StringParameterValue"
      eSuperTypes="#//ParameterValue">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="value"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass"
      name="NumberParameterValue"
      eSuperTypes="#//ParameterValue">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="value"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass"
      name="BoolParameterValue"
      eSuperTypes="#//ParameterValue">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
        name="value"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
    <details key="documentation"
      value="Constraint: Every Item must provide ParameterValues that correspond to the ParameterDefinitions of its ItemType. StringParameterValue must reference a StringParameterDefinition, NumberParameterValue a NumberParameterDefinition, and BoolParameterValue a BoolParameterDefinition."/>
  </eAnnotations>

</ecore:EPackage>
