<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-made after Wimmer et al. 2010, Benchmark Example 6 (Fig. 10), left-hand side. The String attribute kind is reproduced as an enumeration of the values used in the example instances (Professor, FullProf, Assistant). -->
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="lhs6" nsURI="http://example.org/lhs6" nsPrefix="lhs6">
  <eClassifiers xsi:type="ecore:EClass" name="ResearchStaff">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1" eType="#//StaffKind"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="StaffKind">
    <eLiterals name="Professor"/>
    <eLiterals name="FullProf" value="1"/>
    <eLiterals name="Assistant" value="2"/>
  </eClassifiers>
</ecore:EPackage>
