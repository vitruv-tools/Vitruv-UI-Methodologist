<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-made after Wimmer et al. 2010, Benchmark Example 6 (Fig. 10), right-hand side. -->
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="rhs6" nsURI="http://example.org/rhs6" nsPrefix="rhs6">
  <eClassifiers xsi:type="ecore:EClass" name="ResearchStaff" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Professor" abstract="true" eSuperTypes="#//ResearchStaff"/>
  <eClassifiers xsi:type="ecore:EClass" name="FullProf" eSuperTypes="#//Professor"/>
  <eClassifiers xsi:type="ecore:EClass" name="Assistant" eSuperTypes="#//ResearchStaff"/>
</ecore:EPackage>
