# Environment Configuration Example
# Copy this file to .env.local and configure for your environment

# API Base URL - The backend API endpoint
REACT_APP_API_BASE_URL=http://localhost:9811

# Environment identifier - Options: local, staging, production
REACT_APP_ENV=local

# Collaboration server (optional) - WebSocket address of the real-time collaboration server.
# Leave it out to work without live collaboration: the canvas then works as before.
# Locally: ws://localhost:1234. Behind the app's own host: wss://<host>/collaboration
# REACT_APP_COLLABORATION_URL=ws://localhost:1234
