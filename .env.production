# Production Environment Configuration
# This file is used when running `npm run build:production`

# API Base URL for production environment
REACT_APP_API_BASE_URL=https://mwa.sdq.kastel.kit.edu

# Environment identifier
REACT_APP_ENV=production

# Intentionally NOT setting REACT_APP_FAST_LOGIN_REDIRECT_URL: the fast-login redirect URI
# is derived from window.location.origin so that login stays on the host the user came from
# (mwa.sdq.kastel.kit.edu or the IPv6 address). Every origin used must be registered as a
# valid redirect URI in the Keycloak client.