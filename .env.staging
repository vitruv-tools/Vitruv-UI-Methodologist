# Staging Environment Configuration
# This file is used when running `npm run build:staging`

# API Base URL for staging environment
REACT_APP_API_BASE_URL=https://fe3ab829-d558-4834-afcf-6ed7ca440ca4.ka.bw-cloud-instance.org

# Environment identifier
REACT_APP_ENV=staging

# Intentionally NOT setting REACT_APP_FAST_LOGIN_REDIRECT_URL: the fast-login redirect URI
# is derived from window.location.origin so that login stays on the host the user came from.
# Every origin used must be registered as a valid redirect URI in the Keycloak client.